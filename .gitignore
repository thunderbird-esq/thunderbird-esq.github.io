# ===================================================================
# Comprehensive .gitignore for Vue 3 + Vite + TypeScript Projects
# Adapted for the THUNDERBIRD OS repository.
# ===================================================================

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Dependencies
# Do NOT commit this directory.
node_modules

# Build output
# This is the directory created by `pnpm build`.
dist
dist-ssr

# Caches
.vite
*.tsbuildinfo

# Test & Coverage Reports
coverage/
.nyc_output/

# Environment Variables
# Never commit secrets or local environment configuration.
.env
.env.local
.env.*.local

# OS-specific files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini

# IDE / Editor directories
.idea/
.vscode/
*.code-workspace
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Archives - Generally not needed in a repo
*.zip
*.tar
*.gz
*.rar
